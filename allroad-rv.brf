---context:global

assign consider_noise = false   # %consider_noise% | Prefer a low-noise route | boolean
assign consider_river = false   # %consider_river% | Prefer a route along rivers, lakes, etc. | boolean
assign consider_forest = false  # %consider_forest% | Prefer a route in forest or parks | boolean

assign no_steps = false         # %no_steps% | No steps | boolean
assign no_wrong_oneway = false  # %no_wrong oneway% | No one way streets in the opposite direction | boolean

assign dismount_cost = 1000  # %dismount_cost% | Acceptable detour in meters to avoid dismount, from 1 000 000 no dismount at all | number
assign avoid_cycleways = 5   # %avoid_cycleways% | Avoid cycleways (0 - 10): 0 = don't avoid, 10 = strongly avoid | number
assign avoid_elevation = 2   # %avoid_elevation% | Avoid elevation (0 - 10): 0 = don't avoid, 10 = strongly avoid | number

assign totalMass  = 90    # %totalMass% | Total weight of the vehicle including rider and luggage in kg, for estimation of travel time | number
assign maxSpeed   = 90    # Maximum speed of the vehicle in km/h
assign S_C_x      = 0.23   # Drag coefficient times the reference area in m², for estimation of travel time
assign C_r        = 0.004  # Rolling resistance coefficient, for estimation of travel time
assign bikerPower = 125    # %bikerPower% | Average driving power in W, for estimation of travel time  | number


assign ignore_bicycle_no = false  # %ignore_bicycle_no% | Ignore bicyle=no tags. Also allows routing on shuttle transport (bicycle=dismount + foot=no). | boolean


assign turnInstructionMode = 2          # %turnInstructionMode% | Mode for generating turn instructions | [0=none, 1=automatic, 2=locus-style, 3=osmand-style, 4=comment-style, 5=gpsies-style, 6=orux-style]
assign turnInstructionCatchingRange 30  # Within this distance (in m) several turn instructions are combined into one and the turning angles are better approximated to the general direction.
assign turnInstructionRoundabouts true  # Generate turn instructions for roundabouts 

assign avoid_ele multiply avoid_elevation 0.2

assign downhillcost multiply avoid_ele 80
assign downhillcutoff 1
assign uphillcost 0
assign uphillcutoff 1

assign validForBikes true  # Apply turn restrictions for bicycles
assign considerTurnRestrictions true

assign pass1coefficient 2.5
assign pass2coefficient 0

assign elevationpenaltybuffer 7  # Elevation buffer (in m) for elevation calculation. Below this value, uphill or downhill is ignored.
assign elevationmaxbuffer 13     # Maximum buffer size (in m) for elevation calculation. Elevation greater than this value is fully penalized.
assign elevationbufferreduce 1   # Incline or decline (in %) that is applied in between elevationpenaltybuffer and elevationmaxbuffer.



---context:way

assign any_cycleroute or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes route_bicycle_lcn=yes
assign nodeaccessgranted or any_cycleroute lcn=yes

assign cycleway
	or
		highway=cycleway
		and
			highway=path
			bicycle=designated

assign footway
	or
		highway=footway|pedestrian
		and
			highway=path
			foot=designated|yes

assign turncost 
	switch junction=roundabout 100
	50  # Cost for a 90 degree turn. Other angles are calculated with turncost * cos(angle). This does not apply to roundabouts.

assign initialclassifier
	switch route=ferry 2
	switch highway=steps 3
	switch cycleway 4
	switch footway 5
	1

assign initialcost
	switch route=ferry 10000
	switch highway=steps
		switch no_steps 1000000
		dismount_cost
	switch cycleway
		multiply 11.1111112
			multiply avoid_cycleways avoid_cycleways
	switch footway dismount_cost
	0

assign oneway
	switch oneway= junction=roundabout
	oneway=yes

# TODO: cleanup and fix
assign onewaypenalty
	switch
		switch reversedirection=yes oneway oneway=-1
		switch or cycleway=opposite or cycleway=opposite_lane or cycleway=opposite_track oneway:bicycle=no 0
		switch no_wrong_oneway 10000
		switch or highway=primary highway=primary_link 50
		switch or highway=secondary highway=secondary_link 30
		switch or highway=tertiary highway=tertiary_link 25
		20.0
	0.0

assign defaultaccess
	switch access= not motorroad=yes
	switch
		or
			access=private
			access=no
		0
	1

assign bikeaccess
	or
		any_cycleroute
		switch bicycle=
			switch vehicle= defaultaccess
			switch
				or
					vehicle=private
					vehicle=no
				0
			1
			not
				or
					bicycle=private
					or
						and
							not ignore_bicycle_no
							bicycle=no
						bicycle=dismount


assign footaccess
	or
		bikeaccess
		or
			and
				bicycle=dismount
				ignore_bicycle_no
			switch foot= defaultaccess
			not
				or
					foot=private
					foot=no

assign accesspenalty
	switch bikeaccess 0
	switch footaccess 10  # cost for pushing the bike
	10000  # cost for no access or private ways


assign maxspeed_forward
	switch maxspeed:forward=50 50
	switch maxspeed:forward=30 30
	switch maxspeed:forward=10 10
	switch maxspeed:forward=20 20
	switch maxspeed:forward=40 40
	switch maxspeed:forward=60 60
	switch maxspeed:forward=70 70
	switch maxspeed:forward=80 80
	switch maxspeed:forward=90 90
	switch maxspeed:forward=100 100
	switch maxspeed:forward=110 110
	switch maxspeed:forward=120 120
	switch maxspeed:forward=130 130
	switch maxspeed:forward=urban 50
	switch maxspeed:forward=rural 100
	0

assign maxspeed_backward
	switch maxspeed:backward=50 50
	switch maxspeed:backward=30 30
	switch maxspeed:backward=10 10
	switch maxspeed:backward=20 20
	switch maxspeed:backward=40 40
	switch maxspeed:backward=60 60
	switch maxspeed:backward=70 70
	switch maxspeed:backward=80 80
	switch maxspeed:backward=90 90
	switch maxspeed:backward=100 100
	switch maxspeed:backward=110 110
	switch maxspeed:backward=120 120
	switch maxspeed:backward=130 130
	switch maxspeed:backward=urban 50
	switch maxspeed:backward=rural 100
	0

assign maxspeed 
	switch and reversedirection=yes maxspeed_backward maxspeed_backward
	switch and not reversedirection=yes maxspeed_forward maxspeed_forward
	switch maxspeed=50 50
	switch maxspeed=30 30
	switch maxspeed=10 10
	switch maxspeed=20 20
	switch maxspeed=40 40
	switch maxspeed=60 60
	switch maxspeed=70 70
	switch maxspeed=80 80
	switch maxspeed=90 90
	switch maxspeed=100 100
	switch maxspeed=110 110
	switch maxspeed=120 120
	switch maxspeed=130 130
	switch maxspeed=urban 50
	switch maxspeed=rural 100
	999


assign flatspeedpenalty
	switch equal maxspeed 10 1
	switch equal maxspeed 20 0
	switch equal maxspeed 30 0
	switch equal maxspeed 40 0
	switch equal maxspeed 50 0
	0

assign upspeedpenalty
	switch equal maxspeed 10 0.1
	switch equal maxspeed 20 0
	switch equal maxspeed 30 0
	0

assign downspeedpenalty
	switch equal maxspeed 10 2
	switch equal maxspeed 20 1
	switch equal maxspeed 30 0.2
	switch equal maxspeed 40 0
	switch equal maxspeed 50 0
	0


assign noise_penalty
	switch consider_noise
		switch estimated_noise_class=   0
		switch estimated_noise_class=1  0.3
		switch estimated_noise_class=2  0.5
		switch estimated_noise_class=3  0.7
		switch estimated_noise_class=4  1
		switch estimated_noise_class=5  1.2
		switch estimated_noise_class=6  1.5
		0
	0

assign no_river_penalty
	switch consider_river
		switch estimated_river_class=   1
		switch estimated_river_class=1  0.5
		switch estimated_river_class=2  0.4
		switch estimated_river_class=3  0.25
		switch estimated_river_class=4  0.15
		switch estimated_river_class=5  0.1
		switch estimated_river_class=6  0
		99
	0

assign no_forest_penalty
	switch consider_forest
		switch estimated_forest_class=   1
		switch estimated_forest_class=1  0.5
		switch estimated_forest_class=2  0.4
		switch estimated_forest_class=3  0.25
		switch estimated_forest_class=4  0.15
		switch estimated_forest_class=5  0.1
		switch estimated_forest_class=6  0
		99
	0


assign surfacepenalty
	add 
		switch embedded_rails=tram|yes|rail 3
		0
		
		switch surface=asphalt|paved 0
		switch concrete=plates 0.1
		switch concrete=lanes 0.1
		switch surface=concrete|paving_stones 0
		switch surface=wood|metal 0.2
		switch surface=sett|grass_paver 1
		switch surface=cobblestone 5  # add |unhewn_cobblestone when it's added to the routing data
		switch surface=fine_gravel|compacted 1
		switch surface=gravel|pebblestone 10
		switch surface=ground|grass|unpaved|dirt|earth|clay 10
		switch surface=mud|sand 100
		switch tracktype=grade1	0
		switch tracktype=grade2	4
		switch tracktype=grade3	7
		switch tracktype=grade4	9
		switch tracktype=grade5	10
		0

assign uphillsurfacepenalty
	add 
		switch embedded_rails=tram|yes|rail 1
		0
		
		switch surface=asphalt|paved 0
		switch concrete=plates 0
		switch concrete=lanes 0
		switch surface=concrete|paving_stones 0
		switch surface=wood|metal 0
		switch surface=sett|grass_paver 0.2
		switch surface=cobblestone 3  # add |unhewn_cobblestone when it's added to the routing data
		switch surface=fine_gravel|compacted 0.5
		switch surface=gravel|pebblestone 5
		switch surface=ground|grass|unpaved|dirt|earth|clay 5
		switch surface=mud|sand 50
		switch tracktype=grade1	0
		switch tracktype=grade2	3
		switch tracktype=grade3	4
		switch tracktype=grade4	5
		switch tracktype=grade5	5
		0

assign downhillsurfacepenalty
	add 
		switch embedded_rails=tram|yes|rail 10
		0
		
		switch surface=asphalt|paved 0
		switch concrete=plates 0.5
		switch concrete=lanes 1
		switch surface=concrete|paving_stones 0
		switch surface=wood|metal 5
		switch surface=sett|grass_paver 2
		switch surface=cobblestone 20  # add |unhewn_cobblestone when it's added to the routing data
		switch surface=fine_gravel|compacted 10
		switch surface=gravel|pebblestone 50
		switch surface=ground|grass|unpaved|dirt|earth|clay 40
		switch surface=mud|sand 500
		switch tracktype=grade1	0
		switch tracktype=grade2	25
		switch tracktype=grade3	30
		switch tracktype=grade4	35
		switch tracktype=grade5	40
		0

assign smoothnesspenalty
	switch smoothness=excellent|very_good 0
	switch smoothness=good 0
	switch smoothness=intermediate 0.4
	switch smoothness=bad 2
	switch smoothness=very_bad 20
	switch smoothness=horrible 50
	switch smoothness=very_horrible|impassable 100
	0

assign uphillsmoothnesspenalty
	switch smoothness=excellent|very_good 0
	switch smoothness=good 0
	switch smoothness=intermediate 0.1
	switch smoothness=bad 1
	switch smoothness=very_bad 10
	switch smoothness=horrible 30
	switch smoothness=very_horrible|impassable 100
	0

assign downhillsmoothnesspenalty
	switch smoothness=excellent|very_good 0
	switch smoothness=good 0
	switch smoothness=intermediate 1
	switch smoothness=bad 10
	switch smoothness=very_bad 100
	switch smoothness=horrible 500
	switch smoothness=very_horrible|impassable 1000
	0

assign mtb_scale_cost
	switch mtb:scale=0	0
	switch mtb:scale=0+	10
	switch mtb:scale=1	20  # can be steep
	switch not mtb:scale=	9999  # all other mtb:scale
	0

assign surfacing_cost
	max max mtb_scale_cost smoothnesspenalty surfacepenalty

assign uphill_surfacing_cost
	max max mtb_scale_cost uphillsmoothnesspenalty uphillsurfacepenalty

assign downhill_surfacing_cost
	max max mtb_scale_cost downhillsmoothnesspenalty downhillsurfacepenalty
	


assign costfactor
	switch
		and
			highway=
			not route=ferry
		10000  # everything without a highway tag except ferries
	switch
		or
			highway=proposed
			highway=abandoned
		10000
	min 9999
	max 1

	add onewaypenalty
	add accesspenalty
	add surfacing_cost
	add flatspeedpenalty
	add noise_penalty
	add no_river_penalty
	add no_forest_penalty

	max 1
	switch highway=motorway|motorway_link 10000
	switch route=ferry 10.67
	switch highway=trunk|trunk_link 8
	switch highway=primary|primary_link 5
	switch highway=secondary|secondary_link 2
	switch highway=tertiary|tertiary_link 1.1
	switch highway=unclassified 1
	switch highway=residential 1.1
	switch highway=service 1
	switch highway=track 1
	switch cycleway 1
	switch highway=living_street 1.5
	switch highway=road 3
	switch footway 20
	switch highway=steps 50
	switch highway=path 1.1
	switch highway=bridleway 1.2
	20


assign uphillcostfactor
	switch
		and
			highway=
			not route=ferry
		10000  # everything without a highway tag except ferries
	switch
		or
			highway=proposed
			highway=abandoned
		10000
	min 9999
	max 1

	add onewaypenalty
	add accesspenalty
	add uphill_surfacing_cost
	add upspeedpenalty
	add noise_penalty
	add no_river_penalty
	add no_forest_penalty
 
	max 1
	switch highway=motorway|motorway_link 10000
	switch route=ferry 10.67
	switch highway=trunk|trunk_link 20
	switch highway=primary|primary_link 10
	switch highway=secondary|secondary_link 2
	switch highway=tertiary|tertiary_link 1.3
	switch highway=unclassified 1
	switch highway=residential 1
	switch highway=service 1
	switch highway=track 1
	switch cycleway 1
	switch highway=living_street 1
	switch highway=road 2
	switch footway 2
	switch highway=steps 30
	switch highway=path 1
	switch highway=bridleway 1
	20


assign downhillcostfactor
	switch
		and
			highway=
			not route=ferry
		10000  # everything without a highway tag except ferries
	switch
		or
			highway=proposed
			highway=abandoned
		10000
	min 9999
	max 1

	add onewaypenalty
	add accesspenalty
	add downhill_surfacing_cost
	add downspeedpenalty
	add noise_penalty
	add no_river_penalty
	add no_forest_penalty
 
	max 1
	switch highway=motorway|motorway_link 10000
	switch route=ferry 10.67
	switch highway=trunk|trunk_link 3
	switch highway=primary|primary_link 2
	switch highway=secondary|secondary_link 1
	switch highway=tertiary|tertiary_link 1
	switch highway=unclassified 1
	switch highway=residential 1.5
	switch highway=service 1
	switch highway=track 1
	switch cycleway 1.1
	switch highway=living_street 5
	switch highway=road 6
	switch footway 40
	switch highway=steps 300
	switch highway=path 10
	switch highway=bridleway 2
	20


# for generating turn instructions
assign priorityclassifier =

 if   ( highway=motorway         ) then 30
 else if ( highway=motorway_link       ) then 29
 else if ( highway=trunk           ) then 28
 else if ( highway=trunk_link        ) then 27
 else if ( highway=primary          ) then 26
 else if ( highway=primary_link       ) then 25
 else if ( highway=secondary         ) then 24
 else if ( highway=secondary_link      ) then 23
 else if ( highway=tertiary         ) then 22
 else if ( highway=tertiary_link       ) then 21
 else if ( highway=unclassified       ) then 20
 else if ( highway=residential|living_street ) then 6
 else if ( highway=service          ) then 6
 else if ( highway=cycleway         ) then 6
 else if ( bicycle=designated        ) then 6
 else if ( highway=track           ) then if tracktype=grade1 then 6 else 4
 else if ( highway=bridleway|road|path|footway ) then 4
 else if ( highway=steps           ) then 2
 else if ( highway=pedestrian        ) then 2
 else 0



assign isbadoneway
	not equal onewaypenalty 0

assign isgoodoneway
	if reversedirection=yes then oneway=-1
	else if oneway= then junction=roundabout
	else oneway=yes|true|1

assign isroundabout
	junction=roundabout

assign islinktype
	highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link

assign isgoodforcars
	if greater priorityclassifier 6 then true
	else if highway=residential|living_street|service then true
	else if ( and highway=track tracktype=grade1 ) then true
	else false

assign classifiermask
	add
		isbadoneway
		add
			multiply isgoodoneway 2
			add
				multiply isroundabout  4
				add
					multiply islinktype 8
					multiply isgoodforcars 16


# to be able to know in the node context whether we are on a cycleway or similar
assign on_cycleway
	switch highway=path|cycleway|footway true
	false # other highways

# to be able to use reversedirection in the node context
assign way_is_reverse 
	switch reversedirection=yes true
	false



---context:node

assign barrier_cost
	switch barrier=gate				1000
	switch barrier=lift_gate			100
	switch barrier=stile				2000
	switch barrier=cycle_barrier			500
	switch barrier=cattle_grid			200
	switch barrier=kissing_gate			1000
	switch barrier=turnstile			1000
	switch barrier=fence				10000
	switch barrier=border_control			1000
	switch barrier=sally_port			500
	switch barrier=chain				1000
	switch barrier=door				1000
	switch barrier=swing_gate			500
	switch barrier=bump_gate			1000
	switch barrier=hampshire_gate			1000
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=debris				2000
	switch barrier=log				1000
	#switch barrier=chicane				
	switch barrier=kerb				500
	switch barrier=sump_buster			50
	#switch barrier=obstacle			100
	switch barrier=horse_stile			1000
	switch barrier=full-height_turnstile		10000
	#switch barrier=windfall			100
	switch barrier=spikes				1000
	#switch barrier=checkpoint			100
	switch barrier=hedge				10000
	#switch barrier=footgate			100
	switch barrier=tree				1000
	switch barrier=guard_rail			1000
	#switch barrier=bar				100
	#switch barrier=fallen_tree			100
	#switch barrier=jersey_barrier			100
	#switch barrier=motorcycle_barrier		100
	#switch barrier=rope				100
	#switch barrier=stone				100
	#switch barrier=traffic_crossing_pole		100
	0


assign traffic_signals_my_direction
	or
		and not way:way_is_reverse traffic_signals:direction=forward
		and way:way_is_reverse traffic_signals:direction=backward

assign traffic_signals_cost
	switch traffic_signals_my_direction 300
	0

assign is_crossing_with_signals
	switch
		and
			highway=crossing
			crossing=traffic_signals
		true
	false

assign crossing_signals_cost
	switch is_crossing_with_signals
		switch way:on_cycleway 350
		50 # little cost on a road, we may already have traffic_signals_cost, or not, we don't know
	0

assign stop_cost
	switch highway=traffic_signals traffic_signals_cost
	switch highway=crossing crossing_signals_cost
	switch highway=stop 200  # stop sign, TODO: don't count if backwards, don't count if traffic_signals is nearby
	switch railway=crossing|level_crossing 200
	0

assign slow_cost
	add barrier_cost stop_cost


assign defaultaccess
	switch access= 1  # add default barrier restrictions here!
	switch or access=private access=no 0
	1

assign bikeaccess
	or
		nodeaccessgranted=yes
		switch bicycle=
			switch vehicle= defaultaccess
			switch or vehicle=private vehicle=no 0
			1
			switch
				or
					bicycle=private
					and
						not
							or
								highway=crossing
								ignore_bicycle_no
						or
							bicycle=no
							bicycle=dismount
				0
			1

assign footaccess
	or
		bicycle=dismount

		switch foot= defaultaccess
		switch or foot=private foot=no 0
		1

assign node_access_cost
	switch bikeaccess 0 
	switch footaccess dismount_cost
	1000000

assign initialcost
	add slow_cost node_access_cost
