---context:global   # following code refers to global config

assign   allow_ferries        1   # set to 0 to disallow ferries

assign forbidden 1000000

assign   validForBikes        1

assign downhillcost 15
assign downhillcutoff 1.5
assign uphillcost 15
assign uphillcutoff 1.5



---context:way

assign any_cycleroute or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes route_bicycle_lcn=yes
assign nodeaccessgranted or any_cycleroute lcn=yes


assign turncost 30

assign initialcost 
	switch route=ferry	5000
	switch highway=steps	400
	0


assign trafficCost
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          50
	switch or highway=primary highway=primary_link      10
	switch or highway=secondary highway=secondary_link  3
	switch or highway=tertiary highway=tertiary_link    1.4
	switch    highway=unclassified                      1
	switch    highway=residential                       1
	switch    highway=service                           1
	switch    highway=living_street                     1
	switch    highway=footway                           1.5
	switch    highway=pedestrian                        1.5
	switch    highway=cycleway                          1
	switch    highway=bridleway                         1
	switch    highway=track                             1
	switch    highway=path                              1
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2

assign trafficCostDownhill
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          40
	switch or highway=primary highway=primary_link      8
	switch or highway=secondary highway=secondary_link  1.8
	switch or highway=tertiary highway=tertiary_link    1
	switch    highway=unclassified                      1
	switch    highway=residential                       1
	switch    highway=service                           1
	switch    highway=living_street                     1
	switch    highway=footway                           1.7
	switch    highway=pedestrian                        1.7
	switch    highway=cycleway                          1
	switch    highway=bridleway                         1
	switch    highway=track                             1
	switch    highway=path                              1
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2

assign trafficCostUphill
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          70
	switch or highway=primary highway=primary_link      20
	switch or highway=secondary highway=secondary_link  4
	switch or highway=tertiary highway=tertiary_link    1.5
	switch    highway=unclassified                      1
	switch    highway=residential                       1
	switch    highway=service                           1
	switch    highway=living_street                     1
	switch    highway=footway                           1.1
	switch    highway=pedestrian                        1.1
	switch    highway=cycleway                          1
	switch    highway=bridleway                         1
	switch    highway=track                             1
	switch    highway=path                              1
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2


assign smoothnessDefaultGood
	switch	or highway=motorway
			or highway=motorway_link
			or highway=trunk
			or highway=trunk_link
			or highway=primary
			or highway=primary_link
			or highway=secondary
			or highway=secondary_link
			or highway=tertiary
			or highway=tertiary_link
			or highway=unclassified
			or highway=residential
			or highway=living_street
			   highway=pedestrian
			1
			0

assign surfaceCost
	switch smoothness=excellent		1
	switch smoothness=good			1
	switch smoothness=intermediate	1
	switch smoothness=bad			1
	switch smoothness=very_bad		1
	switch smoothness=horrible		1.1
	switch smoothness=very_horrible	1.3
	switch mtb:scale=0-	1
	switch mtb:scale=0	1
	switch mtb:scale=0+	1
	switch mtb:scale=1-	1.3
	switch mtb:scale=1	1.3
	switch mtb:scale=1+	1.3
	switch mtb:scale=2-	3
	switch mtb:scale=2	3
	switch mtb:scale=2+	3
	switch mtb:scale=3	8
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	100
	switch or mtb:scale=5 sac_scale=alpine_hiking			400
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking	500
	switch sac_scale=difficult_alpine_hiking				2000
	switch smoothness=impassable	50
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		1
	switch surface=gravel		1.5
	switch surface=ground		1
	switch surface=dirt		1
	switch surface=grass		1
	switch surface=concrete		1
	switch surface=paving_stones	1
	switch surface=cobblestone	1.2
	switch surface=compacted	1
	switch surface=sand		3
	switch surface=wood		1.1
	switch surface=pebblestone	1
	switch surface=fine_gravel	1
	switch surface=mud		500
	switch tracktype=grade1		1
	switch tracktype=grade2		1
	switch tracktype=grade3		1
	switch tracktype=grade4		1
	switch tracktype=grade5		1
	switch bicycle=designated	1
	switch smoothnessDefaultGood	1
	2

assign surfaceCostDownhill
	switch smoothness=excellent		1
	switch smoothness=good			1
	switch smoothness=intermediate	1
	switch smoothness=bad			1
	switch smoothness=very_bad		1
	switch smoothness=horrible		1.1
	switch smoothness=very_horrible	1.3
	switch mtb:scale=0-	1
	switch mtb:scale=0	1
	switch mtb:scale=0+	1
	switch mtb:scale=1-	1.3
	switch mtb:scale=1	1.3
	switch mtb:scale=1+	1.3
	switch mtb:scale=2-	3
	switch mtb:scale=2	3
	switch mtb:scale=2+	3
	switch mtb:scale=3	8
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	100
	switch or mtb:scale=5 sac_scale=alpine_hiking			400
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking	500
	switch sac_scale=difficult_alpine_hiking				2000
	switch smoothness=impassable	50
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		1
	switch surface=gravel		1.5
	switch surface=ground		1
	switch surface=dirt		1
	switch surface=grass		1
	switch surface=concrete		1
	switch surface=paving_stones	1
	switch surface=cobblestone	1.2
	switch surface=compacted	1
	switch surface=sand		3
	switch surface=wood		1.1
	switch surface=pebblestone	1
	switch surface=fine_gravel	1
	switch surface=mud		500
	switch tracktype=grade1		1
	switch tracktype=grade2		1
	switch tracktype=grade3		1
	switch tracktype=grade4		1
	switch tracktype=grade5		1
	switch bicycle=designated	1
	switch smoothnessDefaultGood	1
	2

assign surfaceCostUphill
	switch smoothness=excellent		1
	switch smoothness=good			1
	switch smoothness=intermediate	1
	switch smoothness=bad			1
	switch smoothness=very_bad		1
	switch smoothness=horrible		1.1
	switch smoothness=very_horrible	1.3
	switch mtb:scale=0-	1
	switch mtb:scale=0	1
	switch mtb:scale=0+	1
	switch mtb:scale=1-	1.3
	switch mtb:scale=1	1.3
	switch mtb:scale=1+	1.3
	switch mtb:scale=2-	3
	switch mtb:scale=2	3
	switch mtb:scale=2+	3
	switch mtb:scale=3	8
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	100
	switch or mtb:scale=5 sac_scale=alpine_hiking			400
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking	500
	switch sac_scale=difficult_alpine_hiking				2000
	switch smoothness=impassable	50
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		1
	switch surface=gravel		1.5
	switch surface=ground		1
	switch surface=dirt		1
	switch surface=grass		1
	switch surface=concrete		1
	switch surface=paving_stones	1
	switch surface=cobblestone	1.2
	switch surface=compacted	1
	switch surface=sand		3
	switch surface=wood		1.1
	switch surface=pebblestone	1
	switch surface=fine_gravel	1
	switch surface=mud		500
	switch tracktype=grade1		1
	switch tracktype=grade2		1
	switch tracktype=grade3		1
	switch tracktype=grade4		1
	switch tracktype=grade5		1
	switch bicycle=designated	1
	switch smoothnessDefaultGood	1
	2
	

# implicit access here just from the motorroad tag
# (implicit access rules from highway tag handled elsewhere)
#
assign defaultAccess
	switch access=
		not motorroad=yes
		not or access=private access=no


# logical bike access
#
assign highwayDefaultBicycleNo or highway=footway or highway=pedestrian highway=bridleway
assign bicycleExplicitAllowed or bicycle=yes or bicycle=designated vehicle=yes
assign bicycleExplicitForbidden or bicycle=private or bicycle=no bicycle=dismount 
assign vehicleExplicitForbidden or vehicle=private vehicle=no

assign vehicleAccess
	switch vehicle=
		defaultAccess
		not vehicleExplicitForbidden

assign bikeAccess
       or	any_cycleroute
		switch highwayDefaultBicycleNo
			bicycleExplicitAllowed
			switch bicycle=
				vehicleAccess
				not bicycleExplicitForbidden


# logical foot access
#
assign footAccess
	or	bicycle=dismount
		switch foot=
				defaultAccess
				not or foot=private foot=no

# if not bike-, but foot-access, just a moderate penalty,
# otherwise access is forbidden
#
assign accessPenalty
       switch bikeAccess
              0
              switch footAccess
                     10
                     forbidden


# handle one-ways. On primary roads, wrong-oneways should
# be close to forbidden, while on other ways we just add
# 4 to the costfactor (making it at least 5 - you are allowed
# to push your bike)
#
assign oneway
	switch oneway=
		junction=roundabout
			oneway=yes

assign onewayPenalty
	switch switch reversedirection=yes oneway oneway=-1
		switch or cycleway=opposite or cycleway=opposite_lane or cycleway=opposite_track oneway:bicycle=no 0
		switch or highway=primary highway=primary_link 50
		switch or highway=secondary highway=secondary_link 30
		switch or highway=tertiary highway=tertiary_link 20
		10
	0

assign costfactor
	add	1
	add	add -1 trafficCost
	add	add -1 surfaceCost
		max onewayPenalty accessPenalty

assign downhillcostfactor
	add	1
	add	add -1 trafficCostDownhill
	add	add -1 surfaceCostDownhill
		max onewayPenalty accessPenalty

assign uphillcostfactor
	add	1
	add	add -1 trafficCostUphill
	add	add -1 surfaceCostUphill
		max onewayPenalty accessPenalty




---context:node

assign barrierPenalties
	switch barrier=gate				500
	switch barrier=lift_gate			10
	switch barrier=stile				800
	switch barrier=cycle_barrier			150
	switch barrier=cattle_grid			20
	switch barrier=kissing_gate			800
	switch barrier=turnstile			800
	switch barrier=fence				10000
	switch barrier=border_control			500
	switch barrier=sally_port			100
	switch barrier=chain				500
	switch barrier=door				500
	switch barrier=swing_gate			0
	switch barrier=bump_gate			500
	switch barrier=hampshire_gate			700
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=debris				500
	switch barrier=log				400
	#switch barrier=chicane				
	switch barrier=kerb				100
	switch barrier=sump_buster			0
	#switch barrier=obstacle				100
	switch barrier=horse_stile			600
	switch barrier=full-height_turnstile	10000
	#switch barrier=windfall				100
	switch barrier=spikes				1000
	#switch barrier=checkpoint			100
	switch barrier=hedge				10000
	#switch barrier=footgate				100
	switch barrier=tree				400
	switch barrier=guard_rail			800
	#switch barrier=bar				100
	#switch barrier=fallen_tree			100
	#switch barrier=jersey_barrier			100
	#switch barrier=motorcycle_barrier		100
	#switch barrier=rope				100
	#switch barrier=stone				100
	#switch barrier=traffic_crossing_pole	100
	0

assign trafficSignalPenalty
	switch highway=traffic_signals 400 0

assign defaultAccess
       switch access=
              1 # add default barrier restrictions here!
              switch or access=private access=no
                     0
                     1

assign bikeAccess
       or nodeaccessgranted=yes
          switch bicycle=
                 switch vehicle=
                        defaultAccess
                        switch or vehicle=private vehicle=no
                               0
                               1
                 switch or bicycle=private or bicycle=no bicycle=dismount
                        0
                        1

assign footAccess
       or bicycle=dismount
          switch foot=
                 defaultAccess
                 switch or foot=private foot=no
                        0
                        1

assign initialcost
	add	barrierPenalties
	add	trafficSignalPenalty
		switch bikeAccess
				0 
				switch footAccess
					300
					forbidden
