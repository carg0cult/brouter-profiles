---context:global

assign forbidden 1000000

assign validForFoot 1

assign downhillcost 10
assign downhillcutoff 1
assign uphillcost 0
assign uphillcutoff 1



---context:way


assign turncost 2

assign initialcost 
	switch route=ferry	5000
	0


assign trafficCost
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          50
	switch or highway=primary highway=primary_link      10
	switch or highway=secondary highway=secondary_link  3
	switch or highway=tertiary highway=tertiary_link    2
	switch    highway=unclassified                      1.3
	switch    highway=residential                       1.5
	switch    highway=service                           1.5
	switch    highway=living_street                     1
	switch    highway=footway                           1
	switch    highway=pedestrian                        1
	switch    highway=cycleway                          1.3
	switch    highway=bridleway                         1
	switch    highway=track                             1.2
	switch    highway=path                              1
	switch    highway=road                              2
	switch    highway=steps                             1
	switch    route=ferry                               5.67 # see issue 28 on github
	5


assign footCost
	switch sac_scale=mountain_hiking		1
	switch sac_scale=demanding_mountain_hiking	1.6
	switch sac_scale=alpine_hiking 		3
	switch sac_scale=demanding_alpine_hiking 	10
	switch sac_scale=difficult_alpine_hiking 	1000
	switch smoothness=excellent		2
	switch smoothness=good			2
	switch smoothness=intermediate	1.7
	switch smoothness=bad			1
	switch smoothness=very_bad		1
	switch smoothness=horrible		1
	switch smoothness=very_horrible	1
	switch smoothness=impassable		1
	switch surface=asphalt		2
	switch surface=paved		2
	switch surface=unpaved		1.7
	switch surface=gravel		1.7
	switch surface=ground		1
	switch surface=dirt		1
	switch surface=grass		1
	switch surface=concrete		2
	switch surface=paving_stones	2
	switch surface=cobblestone	2
	switch surface=compacted	1.7
	switch surface=sand		1.2
	switch surface=wood		1
	switch surface=pebblestone	1.7
	switch surface=fine_gravel	1.7
	switch surface=mud		2
	switch tracktype=grade1		2
	switch tracktype=grade2		2
	switch tracktype=grade3		1.7
	switch tracktype=grade4		1.5
	switch tracktype=grade5		1.3
	5


assign costfactor
	add	1
	add	add -1 trafficCost
	add -1 footCost




---context:node

assign barrierPenalties
	switch barrier=fence				10000
	switch barrier=border_control			500
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=hedge				10000
	0

assign initialcost barrierPenalties
