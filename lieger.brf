---context:global

assign forbidden 1000000

assign validForBikes 1

assign downhillcost 100
assign downhillcutoff 1
assign uphillcost 0
assign uphillcutoff 1



---context:way

assign any_cycleroute or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes route_bicycle_lcn=yes
assign nodeaccessgranted or any_cycleroute lcn=yes


assign turncost = if junction=roundabout then 0
                  else 120

assign initialcost 
	switch route=ferry	5000
	switch highway=steps	500
	0


assign trafficCost
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          10
	switch or highway=primary highway=primary_link      1.2
	switch or highway=secondary highway=secondary_link  1
	switch or highway=tertiary highway=tertiary_link    1
	switch    highway=unclassified                      1.5
	switch    highway=residential                       2
	switch    highway=service                           2
	switch    highway=living_street                     3
	switch    highway=footway                           10
	switch    highway=pedestrian                        10
	switch    highway=cycleway                          3
	switch    highway=bridleway                         2
	switch    highway=track                             2
	switch    highway=path                              3
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2

assign trafficCostDownhill
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          8
	switch or highway=primary highway=primary_link      1
	switch or highway=secondary highway=secondary_link  1
	switch or highway=tertiary highway=tertiary_link    1
	switch    highway=unclassified                      2
	switch    highway=residential                       3
	switch    highway=service                           3
	switch    highway=living_street                     8
	switch    highway=footway                           20
	switch    highway=pedestrian                        20
	switch    highway=cycleway                          5
	switch    highway=bridleway                         3
	switch    highway=track                             3
	switch    highway=path                              5
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2

assign trafficCostUphill
	switch and highway= not route=ferry                 forbidden
	switch or highway=motorway highway=motorway_link    forbidden
	switch or highway=proposed highway=abandoned        forbidden
	switch or highway=trunk highway=trunk_link          20
	switch or highway=primary highway=primary_link      2
	switch or highway=secondary highway=secondary_link  1.2
	switch or highway=tertiary highway=tertiary_link    1
	switch    highway=unclassified                      1.2
	switch    highway=residential                       1.3
	switch    highway=service                           1.3
	switch    highway=living_street                     1.4
	switch    highway=footway                           2
	switch    highway=pedestrian                        2
	switch    highway=cycleway                          1.5
	switch    highway=bridleway                         1
	switch    highway=track                             1
	switch    highway=path                              1.5
	switch    highway=road                              2
	switch    highway=steps                             5.67 # seems to be a magic number to make initialcost work
	switch    route=ferry                               5.67 # see issue 28 on github
	2


assign smoothnessDefaultGood
	switch	or highway=motorway
			or highway=motorway_link
			or highway=trunk
			or highway=trunk_link
			or highway=primary
			or highway=primary_link
			or highway=secondary
			or highway=secondary_link
			or highway=tertiary
			or highway=tertiary_link
			or highway=unclassified
			or highway=residential
			or highway=living_street
			   highway=pedestrian
			1
			0

assign surfaceCost
	switch smoothness=excellent	1
	switch smoothness=good		1
	switch smoothness=intermediate	2
	switch smoothness=bad		10
	switch smoothness=very_bad	20
	switch smoothness=horrible	40
	switch smoothness=very_horrible	80
	switch smoothness=impassable	500
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		4
	switch surface=gravel		4
	switch surface=ground		4
	switch surface=dirt		4
	switch surface=grass		4
	switch surface=concrete		1.1
	switch surface=paving_stones	1.5
	switch surface=cobblestone	5
	switch surface=compacted	4
	switch surface=sand		20
	switch surface=wood		2
	switch surface=pebblestone	4
	switch surface=fine_gravel	2
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		2
	switch tracktype=grade3		4
	switch tracktype=grade4		6
	switch tracktype=grade5		10
	switch bicycle=designated	1.1
	switch smoothnessDefaultGood	1
	2

assign surfaceCostDownhill
	switch smoothness=excellent	1
	switch smoothness=good		1.1
	switch smoothness=intermediate	3
	switch smoothness=bad		20
	switch smoothness=very_bad	40
	switch smoothness=horrible	80
	switch smoothness=very_horrible	160
	switch smoothness=impassable	1000
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		8
	switch surface=gravel		8
	switch surface=ground		8
	switch surface=dirt		8
	switch surface=grass		8
	switch surface=concrete		1.3
	switch surface=paving_stones	2
	switch surface=cobblestone	10
	switch surface=compacted	4
	switch surface=sand		40
	switch surface=wood		3
	switch surface=pebblestone	5
	switch surface=fine_gravel	3
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		3
	switch tracktype=grade3		6
	switch tracktype=grade4		10
	switch tracktype=grade5		15
	switch bicycle=designated	1.2
	switch smoothnessDefaultGood	1
	2

assign surfaceCostUphill
	switch smoothness=excellent	1
	switch smoothness=good		1
	switch smoothness=intermediate	1.6
	switch smoothness=bad		5
	switch smoothness=very_bad	10
	switch smoothness=horrible	20
	switch smoothness=very_horrible	40
	switch smoothness=impassable	100
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		2
	switch surface=gravel		2
	switch surface=ground		2
	switch surface=dirt		2
	switch surface=grass		2
	switch surface=concrete		1
	switch surface=paving_stones	1.2
	switch surface=cobblestone	3
	switch surface=compacted	2
	switch surface=sand		20
	switch surface=wood		1.3
	switch surface=pebblestone	2
	switch surface=fine_gravel	1.6
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		1.6
	switch tracktype=grade3		2
	switch tracktype=grade4		3
	switch tracktype=grade5		5
	switch bicycle=designated	1.1
	switch smoothnessDefaultGood	1
	2
	

# implicit access here just from the motorroad tag
# (implicit access rules from highway tag handled elsewhere)
#
assign defaultAccess
	switch access=
		not motorroad=yes
		not or access=private access=no

assign highwayDefaultBicycleNo or highway=footway or highway=pedestrian highway=bridleway
assign bicycleExplicitAllowed or bicycle=yes or bicycle=designated vehicle=yes
assign bicycleExplicitForbidden or bicycle=private or bicycle=no bicycle=dismount 
assign vehicleExplicitForbidden or vehicle=private vehicle=no

assign vehicleAccess
	switch vehicle=
		defaultAccess
		not vehicleExplicitForbidden

assign bikeAccess
       or	any_cycleroute
		switch highwayDefaultBicycleNo
			bicycleExplicitAllowed
			switch bicycle=
				vehicleAccess
				not bicycleExplicitForbidden

assign footAccess
	or	bicycle=dismount
		switch foot=
			defaultAccess
			not or foot=private foot=no

assign accessPenalty
       switch bikeAccess
              0
              switch footAccess
                     6
                     forbidden


assign oneway
	switch oneway=
		junction=roundabout
			oneway=yes

assign onewayPenalty
	switch switch reversedirection=yes oneway oneway=-1
		switch or cycleway=opposite or cycleway=opposite_lane or cycleway=opposite_track oneway:bicycle=no 0
		switch or highway=primary highway=primary_link 50
		switch or highway=secondary highway=secondary_link 30
		switch or highway=tertiary highway=tertiary_link 20
		10
	0

assign costfactor
	add	1
	add	add -1 trafficCost
	add	add -1 surfaceCost
		max onewayPenalty accessPenalty

assign downhillcostfactor
	add	1
	add	add -1 trafficCostDownhill
	add	add -1 surfaceCostDownhill
		max onewayPenalty accessPenalty

assign uphillcostfactor
	add	1
	add	add -1 trafficCostUphill
	add	add -1 surfaceCostUphill
		max onewayPenalty accessPenalty




---context:node

assign barrierPenalties
	switch barrier=gate				1000
	switch barrier=lift_gate			100
	switch barrier=stile				2000
	switch barrier=cycle_barrier			500
	switch barrier=cattle_grid			200
	switch barrier=kissing_gate			1000
	switch barrier=turnstile			1000
	switch barrier=fence				10000
	switch barrier=border_control			1000
	switch barrier=sally_port			500
	switch barrier=chain				1000
	switch barrier=door				1000
	switch barrier=swing_gate			500
	switch barrier=bump_gate			1000
	switch barrier=hampshire_gate			1000
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=debris				2000
	switch barrier=log				1000
	#switch barrier=chicane				
	switch barrier=kerb				300
	switch barrier=sump_buster			50
	#switch barrier=obstacle			100
	switch barrier=horse_stile			1000
	switch barrier=full-height_turnstile		10000
	#switch barrier=windfall			100
	switch barrier=spikes				1000
	#switch barrier=checkpoint			100
	switch barrier=hedge				10000
	#switch barrier=footgate			100
	switch barrier=tree				1000
	switch barrier=guard_rail			1000
	#switch barrier=bar				100
	#switch barrier=fallen_tree			100
	#switch barrier=jersey_barrier			100
	#switch barrier=motorcycle_barrier		100
	#switch barrier=rope				100
	#switch barrier=stone				100
	#switch barrier=traffic_crossing_pole		100
	0

assign trafficSignalPenalty
	switch highway=traffic_signals 300 0

assign defaultAccess
       switch access=
              1 # add default barrier restrictions here!
              switch or access=private access=no
                     0
                     1

assign bikeAccess
       or nodeaccessgranted=yes
          switch bicycle=
                 switch vehicle=
                        defaultAccess
                        switch or vehicle=private vehicle=no
                               0
                               1
                 switch or bicycle=private or bicycle=no bicycle=dismount
                        0
                        1

assign footAccess
       or bicycle=dismount
          switch foot=
                 defaultAccess
                 switch or foot=private foot=no
                        0
                        1

assign initialcost
	add	barrierPenalties
	add	trafficSignalPenalty
		switch bikeAccess
				0 
				switch footAccess
					300
					forbidden
