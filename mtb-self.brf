---context:global   # following code refers to global config

# generate a bike route
assign validForBikes            1
assign validForCars             0

assign forbidden 1000000


---context:way   # following code refers to way-tags

assign turncost 0

assign initialcost switch route=ferry 5000 0

assign highwayPenalty
	switch or highway=motorway highway=motorway_link	forbidden
	switch or highway=trunk highway=trunk_link		50
	switch highway=primary						5
	switch highway=steps switch mtb:scale=			100 0
	0

assign mtbCost
	switch and mtb:scale= smoothness=	4
	switch smoothness=excellent		4
	switch smoothness=good			4
	switch smoothness=intermediate	3
	switch smoothness=bad			2
	switch smoothness=very_bad		1
	switch smoothness=horrible		1
	switch smoothness=very_horrible	1
	switch mtb:scale=0-	4
	switch mtb:scale=0	2
	switch mtb:scale=0+	1.2
	switch mtb:scale=1-	1
	switch mtb:scale=1	1
	switch mtb:scale=1+	1
	switch mtb:scale=2-	1.2
	switch mtb:scale=2	1.5
	switch mtb:scale=2+	1.8
	switch mtb:scale=3	8
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	100
	switch or mtb:scale=5 sac_scale=alpine_hiking			400
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking	500
	switch sac_scale=difficult_alpine_hiking				2000
	switch smoothness=impassable		50
	4

assign costfactor add mtbCost highwayPenalty

---context:node  # following code refers to node tags

assign initialcost
	switch barrier=gate				100
	switch barrier=lift_gate			100
	switch barrier=stile				100
	switch barrier=cycle_barrier			100
	switch barrier=cattle_grid			100
	switch barrier=kissing_gate			100
	switch barrier=turnstile			100
	switch barrier=fence				10000
	switch barrier=border_control			100
	switch barrier=sally_port			100
	switch barrier=chain				100
	switch barrier=door				100
	switch barrier=swing_gate			100
	switch barrier=bump_gate			100
	switch barrier=hampshire_gate			100
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=debris				100
	switch barrier=log				100
	switch barrier=chicane				100
	switch barrier=kerb				100
	switch barrier=sump_buster			100
	switch barrier=obstacle				100
	switch barrier=horse_stile			100
	switch barrier=full-height_turnstile	10000
	switch barrier=windfall				100
	switch barrier=spikes				100
	switch barrier=checkpoint			100
	switch barrier=hedge				10000
	switch barrier=footgate				100
	switch barrier=tree				100
	switch barrier=guard_rail			100
	switch barrier=bar				100
	switch barrier=fallen_tree			100
	switch barrier=jersey_barrier			100
	switch barrier=motorcycle_barrier		100
	switch barrier=rope				100
	switch barrier=stone				100
	switch barrier=traffic_crossing_pole	100
	0
