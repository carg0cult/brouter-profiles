---context:global

# Use the following switches to change behaviour
# (1=yes, 0=no):

assign   consider_elevation   = true   # set to false to ignore elevation in routing
assign   allow_steps          = false   # set to false to disallow steps
assign   allow_ferries        = true   # set to false to disallow ferries
assign   ignore_cycleroutes   = true   # set to true for better elevation results
assign   avoid_unsafe         = false   # set to true to avoid standard highways
assign   turnInstructionMode  = 2  # 0=none, 1=auto-choose, 2=locus-style, 3=osmand-style

assign   validForBikes        = true

# the elevation parameters

assign downhillcost    = if consider_elevation then 80 else 0
assign downhillcutoff  = 1.5
assign uphillcost      = 0
assign uphillcutoff    = 1.5


# classifier constants

assign classifier_none     = 1
assign classifier_ferry    = 2



---context:way

#
# pre-calculate some logical expressions
#

assign any_cycleroute =
     if      route_bicycle_icn=yes then true
     else if route_bicycle_ncn=yes then true
     else if route_bicycle_rcn=yes then true
     else if route_bicycle_lcn=yes then true
     else false

assign nodeaccessgranted =
     if any_cycleroute then true
     else lcn=yes

assign is_ldcr =
     if ignore_cycleroutes then false
     else any_cycleroute

assign isbike = or bicycle=yes or or bicycle=permissive bicycle=designated lcn=yes
assign ispaved = surface=paved|asphalt|concrete|paving_stones
assign isunpaved = not or surface= or ispaved surface=fine_gravel|cobblestone
assign probablyGood = or ispaved and isbike not isunpaved


#
# this is the cost (in Meter) for a 90-degree turn
# The actual cost is calculated as turncost*cos(angle)
# (Suppressing turncost while following longdistance-cycleways
# makes them a little bit more magnetic)
#
assign turncost = if is_ldcr then 0
                  else if junction=roundabout then 60
                  else 800


#
# for any change in initialclassifier, initialcost is added once
#
assign initialclassifier =
     if route=ferry then classifier_ferry
     else classifier_none


#
# calculate the initial cost
# this is added to the total cost each time the costfactor
# changed
#
assign initialcost =
     if ( equal initialclassifier classifier_ferry ) then 10000
     else 0

#
# implicit access here just from the motorroad tag
# (implicit access rules from highway tag handled elsewhere)
#
assign defaultaccess =
       if access= then not motorroad=yes
       else if access=private|no then false
       else true

#
# calculate logical bike access
#
assign bikeaccess =
       if any_cycleroute then true
       else if bicycle= then
       (
         if vehicle= then defaultaccess
         else not vehicle=private|no
       )
       else not bicycle=private|no|dismount

#
# calculate logical foot access
#
assign footaccess =
       if bikeaccess then true
       else if bicycle=dismount then true
       else if foot= then defaultaccess
       else not foot=private|no

#
# if not bike-, but foot-acess, just a moderate penalty,
# otherwise access is forbidden
#
assign accesspenalty =
       if bikeaccess then 0
       else if footaccess then 10
       else 10000

#
# handle one-ways. On primary roads, wrong-oneways should
# be close to forbidden, while on other ways we just add
# 4 to the costfactor (making it at least 5 - you are allowed
# to push your bike)
#
assign badoneway =
       if reversedirection=yes then
         if oneway= then junction=roundabout else oneway=yes|true|1
       else oneway=-1

assign onewaypenalty =
       if ( badoneway ) then
       (
         if ( cycleway=opposite|opposite_lane|opposite_track ) then 0
         else if ( oneway:bicycle=no                         ) then 0
         else if ( highway=primary|primary_link              ) then 50
         else if ( highway=secondary|secondary_link          ) then 30
         else if ( highway=tertiary|tertiary_link            ) then 20
         else 10.0
       )
       else 0.0

assign smoothnessDefaultGood
	if ( highway=motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|residential|living_street|pedestrian ) then true
	else false

assign surfaceCost
	switch smoothness=excellent	1
	switch smoothness=good		1
	switch smoothness=intermediate	1.5
	switch smoothness=bad		5
	switch smoothness=very_bad	20
	switch smoothness=horrible	40
	switch smoothness=very_horrible	80
	switch smoothness=impassable	500
	switch mtb:scale=0+	10
	switch mtb:scale=1-	40
	switch mtb:scale=1	40
	switch mtb:scale=1+	40
	switch mtb:scale=2-	80
	switch mtb:scale=2	80
	switch mtb:scale=2+	80
	switch mtb:scale=3	200
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	10000
	switch or mtb:scale=5 sac_scale=alpine_hiking			10000
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking		10000
	switch sac_scale=difficult_alpine_hiking			10000
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		4
	switch surface=gravel		4
	switch surface=ground		4
	switch surface=dirt		4
	switch surface=grass		4
	switch surface=concrete		1.2
	switch surface=paving_stones	1.5
	switch surface=cobblestone	5
	switch surface=compacted	4
	switch surface=sand		20
	switch surface=wood		2
	switch surface=pebblestone	4
	switch surface=fine_gravel	2
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		2
	switch tracktype=grade3		4
	switch tracktype=grade4		6
	switch tracktype=grade5		10
	switch bicycle=designated	1.1
	switch smoothnessDefaultGood	1
	2

assign surfaceCostDownhill
	switch smoothness=excellent	1
	switch smoothness=good		1
	switch smoothness=intermediate	3
	switch smoothness=bad		20
	switch smoothness=very_bad	40
	switch smoothness=horrible	80
	switch smoothness=very_horrible	160
	switch smoothness=impassable	1000
	switch mtb:scale=0+	20
	switch mtb:scale=1-	80
	switch mtb:scale=1	80
	switch mtb:scale=1+	80
	switch mtb:scale=2-	200
	switch mtb:scale=2	200
	switch mtb:scale=2+	200
	switch mtb:scale=3	200
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	10000
	switch or mtb:scale=5 sac_scale=alpine_hiking			10000
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking		10000
	switch sac_scale=difficult_alpine_hiking			10000
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		8
	switch surface=gravel		8
	switch surface=ground		8
	switch surface=dirt		8
	switch surface=grass		8
	switch surface=concrete		1.5
	switch surface=paving_stones	2
	switch surface=cobblestone	10
	switch surface=compacted	4
	switch surface=sand		40
	switch surface=wood		3
	switch surface=pebblestone	5
	switch surface=fine_gravel	3
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		3
	switch tracktype=grade3		6
	switch tracktype=grade4		10
	switch tracktype=grade5		15
	switch bicycle=designated	1.2
	switch smoothnessDefaultGood	1
	2

assign surfaceCostUphill
	switch smoothness=excellent	1
	switch smoothness=good		1
	switch smoothness=intermediate	1.3
	switch smoothness=bad		4
	switch smoothness=very_bad	10
	switch smoothness=horrible	20
	switch smoothness=very_horrible	40
	switch smoothness=impassable	100
	switch mtb:scale=0+	10
	switch mtb:scale=1-	40
	switch mtb:scale=1	40
	switch mtb:scale=1+	40
	switch mtb:scale=2-	80
	switch mtb:scale=2	80
	switch mtb:scale=2+	80
	switch mtb:scale=3	200
	switch or mtb:scale=4 sac_scale=demanding_mountain_hiking 	10000
	switch or mtb:scale=5 sac_scale=alpine_hiking			10000
	switch or mtb:scale=6 sac_scale=demanding_alpine_hiking		10000
	switch sac_scale=difficult_alpine_hiking			10000
	switch surface=asphalt		1
	switch surface=paved		1
	switch surface=unpaved		3
	switch surface=gravel		3
	switch surface=ground		3
	switch surface=dirt		3
	switch surface=grass		3
	switch surface=concrete		1.1
	switch surface=paving_stones	1.2
	switch surface=cobblestone	3
	switch surface=compacted	2
	switch surface=sand		20
	switch surface=wood		1.3
	switch surface=pebblestone	2
	switch surface=fine_gravel	1.6
	switch surface=mud		100
	switch tracktype=grade1		1
	switch tracktype=grade2		1.6
	switch tracktype=grade3		2
	switch tracktype=grade4		3
	switch tracktype=grade5		5
	switch bicycle=designated	1.1
	switch smoothnessDefaultGood	1
	2

assign maxspeedCost
	switch maxspeed=10 2
	switch maxspeed=20 1.5
	switch maxspeed=30 1
	switch maxspeed=40 1
	1

assign maxspeedCostDownhill
	switch maxspeed=10 4
	switch maxspeed=20 2
	switch maxspeed=30 1.3
	switch maxspeed=40 1
	switch maxspeed=50 1
	1

assign maxspeedCostUphill
	switch maxspeed=10 1.1
	1

#
# calculate the cost-factor, which is the factor
# by which the distance of a way-segment is multiplied
# to calculate the cost of that segment. The costfactor
# must be >=1 and it's supposed to be close to 1 for
# the type of way the routing profile is searching for
#
assign costfactor

  #
  # exclude rivers, rails etc.
  #
  if ( and highway= not route=ferry ) then 10000

  #
  # exclude motorways and proposed roads
  #
  else if ( highway=motorway|motorway_link ) then   10000
  else if ( highway=proposed|abandoned     ) then   10000

  #
  # all other exclusions below (access, steps, ferries,..)
  # should not be deleted by the decoder, to be available
  # in voice-hint-processing
  #
  else min 9999

  #
  # apply oneway-and access-penalties
  #
  add max onewaypenalty accesspenalty

  #
  # steps and ferries are special. Note this is handled
  # before the cycleroute-switch, to be able
  # to really exlude them be setting cost to infinity 
  #
  if ( highway=steps ) then ( if allow_steps then 50 else 10000 )
  else if ( route=ferry   ) then ( if allow_ferries then 5.67 else 10000 )
  else
  add add -1 surfaceCost
  add add -1 maxspeedCost

       if ( highway=trunk|trunk_link         ) then ( if isbike then 4.0 else 10  )
  else if ( highway=primary|primary_link     ) then 2
  else if ( highway=secondary|secondary_link ) then 1.2
  else if ( highway=tertiary|tertiary_link   ) then 1
  else if ( highway=unclassified             ) then 1
  else if ( highway=residential              ) then 1.3
  else if ( highway=service                  ) then 1
  else if ( highway=living_street            ) then 2
  else if ( highway=footway                  ) then 3
  else if ( highway=pedestrian               ) then 3
  else if ( highway=cycleway                 ) then 1
  else if ( highway=bridleway                ) then 2
  else if ( highway=track                    ) then 1
  else if ( highway=path                     ) then 4
  else if ( highway=road                     ) then 2

  #
  # default for any other highway type not handled above
  #
  else 2


assign downhillcostfactor

  #
  # exclude rivers, rails etc.
  #
  if ( and highway= not route=ferry ) then 10000

  #
  # exclude motorways and proposed roads
  #
  else if ( highway=motorway|motorway_link ) then   10000
  else if ( highway=proposed|abandoned     ) then   10000

  #
  # all other exclusions below (access, steps, ferries,..)
  # should not be deleted by the decoder, to be available
  # in voice-hint-processing
  #
  else min 9999

  #
  # apply oneway-and access-penalties
  #
  add max onewaypenalty accesspenalty

  #
  # steps and ferries are special. Note this is handled
  # before the cycleroute-switch, to be able
  # to really exlude them be setting cost to infinity 
  #
  if ( highway=steps ) then ( if allow_steps then 50 else 10000 )
  else if ( route=ferry   ) then ( if allow_ferries then 5.67 else 10000 )
  else
  add add -1 surfaceCostDownhill
  add add -1 maxspeedCostDownhill

       if ( highway=trunk|trunk_link         ) then ( if isbike then 6.0 else 8  )
  else if ( highway=primary|primary_link     ) then 1.2
  else if ( highway=secondary|secondary_link ) then 1
  else if ( highway=tertiary|tertiary_link   ) then 1
  else if ( highway=unclassified             ) then 1
  else if ( highway=residential              ) then 2
  else if ( highway=service                  ) then 1
  else if ( highway=living_street            ) then 2
  else if ( highway=footway                  ) then 5
  else if ( highway=pedestrian               ) then 5
  else if ( highway=cycleway                 ) then 1
  else if ( highway=bridleway                ) then 1.5
  else if ( highway=track                    ) then 1.2
  else if ( highway=path                     ) then 3
  else if ( highway=road                     ) then 2

  #
  # default for any other highway type not handled above
  #
  else 2


assign uphillcostfactor

  #
  # exclude rivers, rails etc.
  #
  if ( and highway= not route=ferry ) then 10000

  #
  # exclude motorways and proposed roads
  #
  else if ( highway=motorway|motorway_link ) then   10000
  else if ( highway=proposed|abandoned     ) then   10000

  #
  # all other exclusions below (access, steps, ferries,..)
  # should not be deleted by the decoder, to be available
  # in voice-hint-processing
  #
  else min 9999

  #
  # apply oneway-and access-penalties
  #
  add max onewaypenalty accesspenalty

  #
  # steps and ferries are special. Note this is handled
  # before the cycleroute-switch, to be able
  # to really exlude them be setting cost to infinity 
  #
  if ( highway=steps ) then ( if allow_steps then 50 else 10000 )
  else if ( route=ferry   ) then ( if allow_ferries then 5.67 else 10000 )
  else
  add add -1 surfaceCostUphill
  add add -1 maxspeedCostUphill

       if ( highway=trunk|trunk_link         ) then ( if isbike then 4.0 else 20  )
  else if ( highway=primary|primary_link     ) then 3
  else if ( highway=secondary|secondary_link ) then 1.3
  else if ( highway=tertiary|tertiary_link   ) then 1
  else if ( highway=unclassified             ) then 1
  else if ( highway=residential              ) then 1
  else if ( highway=service                  ) then 1
  else if ( highway=living_street            ) then 1
  else if ( highway=footway                  ) then 1.5
  else if ( highway=pedestrian               ) then 1.5
  else if ( highway=cycleway                 ) then 1
  else if ( highway=bridleway                ) then 1
  else if ( highway=track                    ) then 1
  else if ( highway=path                     ) then 1.2
  else if ( highway=road                     ) then 2

  #
  # default for any other highway type not handled above
  #
  else 2


# way priorities used for voice hint generation

assign priorityclassifier =

  if      ( highway=motorway                          ) then  30
  else if ( highway=motorway_link                     ) then  29
  else if ( highway=trunk                             ) then  28
  else if ( highway=trunk_link                        ) then  27
  else if ( highway=primary                           ) then  26
  else if ( highway=primary_link                      ) then  25
  else if ( highway=secondary                         ) then  24
  else if ( highway=secondary_link                    ) then  23
  else if ( highway=tertiary                          ) then  22
  else if ( highway=tertiary_link                     ) then  21
  else if ( highway=unclassified                      ) then  20
  else if ( highway=residential|living_street         ) then  6
  else if ( highway=service                           ) then  6
  else if ( highway=cycleway                          ) then  6
  else if ( or bicycle=designated bicycle_road=yes    ) then  6
  else if ( highway=track                             ) then if tracktype=grade1 then 6 else 4
  else if ( highway=bridleway|road|path|footway       ) then  4
  else if ( highway=steps                             ) then  2
  else if ( highway=pedestrian                        ) then  2
  else 0

# some more classifying bits used for voice hint generation...

assign isbadoneway = not equal onewaypenalty 0
assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if highway=residential|living_street|service then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

# ... encoded into a bitmask

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                          multiply isgoodforcars 16




---context:node

assign barrierPenalties
	switch barrier=gate				1000
	switch barrier=lift_gate			100
	switch barrier=stile				2000
	switch barrier=cycle_barrier			500
	switch barrier=cattle_grid			200
	switch barrier=kissing_gate			1000
	switch barrier=turnstile			1000
	switch barrier=fence				10000
	switch barrier=border_control			1000
	switch barrier=sally_port			500
	switch barrier=chain				1000
	switch barrier=door				1000
	switch barrier=swing_gate			500
	switch barrier=bump_gate			1000
	switch barrier=hampshire_gate			1000
	switch barrier=wall				10000
	switch barrier=ditch				10000
	switch barrier=debris				2000
	switch barrier=log				1000
	#switch barrier=chicane				
	switch barrier=kerb				300
	switch barrier=sump_buster			50
	#switch barrier=obstacle			100
	switch barrier=horse_stile			1000
	switch barrier=full-height_turnstile		10000
	#switch barrier=windfall			100
	switch barrier=spikes				1000
	#switch barrier=checkpoint			100
	switch barrier=hedge				10000
	#switch barrier=footgate			100
	switch barrier=tree				1000
	switch barrier=guard_rail			1000
	#switch barrier=bar				100
	#switch barrier=fallen_tree			100
	#switch barrier=jersey_barrier			100
	#switch barrier=motorcycle_barrier		100
	#switch barrier=rope				100
	#switch barrier=stone				100
	#switch barrier=traffic_crossing_pole		100
	0

assign trafficSignalPenalty
	switch highway=traffic_signals 400 0

assign defaultAccess
       switch access=
              1 # add default barrier restrictions here!
              switch or access=private access=no
                     0
                     1

assign bikeAccess
       or nodeaccessgranted=yes
          switch bicycle=
                 switch vehicle=
                        defaultAccess
                        switch or vehicle=private vehicle=no
                               0
                               1
                 switch or bicycle=private or bicycle=no bicycle=dismount
                        0
                        1

assign footAccess
       or bicycle=dismount
          switch foot=
                 defaultAccess
                 switch or foot=private foot=no
                        0
                        1

assign initialcost
	add	barrierPenalties
	add	trafficSignalPenalty
		switch bikeAccess
				0 
				switch footAccess
					300
					10000
